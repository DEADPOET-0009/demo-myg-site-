<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Documents</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, Arial, sans-serif;
            background: #f4f6fa;
            color: #1c2430;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .main-box {
            max-width: 1180px;
            margin: 0 auto;
            padding: 20px 20px 50px;
        }

        .crumbs {
            margin-bottom: 14px;
            font-size: 13px;
            color: #6b7686;
        }

        .crumbs a {
            color: #1976d2;
        }

        .crumbs a:hover {
            text-decoration: underline;
        }

        .banner {
            background: linear-gradient(120deg, #0d47a1, #42a5f5);
            color: #fff;
            border-radius: 14px;
            padding: 30px 32px;
            margin-bottom: 26px;
        }

        .banner h1 {
            font-size: 30px;
            margin-bottom: 6px;
        }

        .banner p {
            opacity: .9;
        }

        .g0 {
            background: linear-gradient(135deg, #42a5f5, #1565c0);
        }

        .g1 {
            background: linear-gradient(135deg, #ab47bc, #6a1b9a);
        }

        .g2 {
            background: linear-gradient(135deg, #26a69a, #00695c);
        }

        .g3 {
            background: linear-gradient(135deg, #ffa726, #e65100);
        }

        .g4 {
            background: linear-gradient(135deg, #ef5350, #b71c1c);
        }

        .brand-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
            gap: 18px;
        }

        .brand-card {
            background: #fff;
            border: 1px solid #e3e8ef;
            border-radius: 14px;
            padding: 28px 16px;
            text-align: center;
            transition: .2s;
        }

        .brand-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 26px rgba(20, 40, 80, .14);
        }

        .badge {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            margin: 0 auto 14px;
            color: #fff;
            font-size: 34px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-card h3 {
            font-size: 18px;
            margin-bottom: 4px;
        }

        .brand-card p {
            font-size: 13px;
            color: #6b7686;
        }
    </style>
</head>

<body>
    <div class="main-box">

        <div class="crumbs"><a href="/">Home</a> &rsaquo; Mobile Phones</div>

        <section class="banner">
            <h1>Mobile Phones</h1>
            <p>Pick a brand to explore the latest phones.</p>
        </section>

        <div class="brand-grid">
            <% brands.forEach((b, i)=> { %>
                <a class="brand-card" href="/mobilephone/<%= b.name %>">
                    <div class="badge g<%= i % 5 %>">
                        <%= b.name.charAt(0) %>
                    </div>
                    <h3>
                        <%= b.name %>
                    </h3>
                    <p>
                        <%= b.phones.length %>
                            <%= b.phones.length===1 ? 'phone' : 'phones' %>
                    </p>
                </a>
                <% }) %>
        </div>
    </div>
</body>

</html>