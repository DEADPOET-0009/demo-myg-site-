<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        Documents
    </title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, Arial, sans-serif;
            background: #f4f6fa;
            color: #1c2430;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .wrap {
            max-width: 1180px;
            margin: 0 auto;
            padding: 20px 20px 50px;
        }

        .crumbs {
            margin-bottom: 14px;
            font-size: 13px;
            color: #6b7686;
        }

        .crumbs a {
            color: #1976d2;
        }

        .crumbs a:hover {
            text-decoration: underline;
        }

        .banner {
            background: linear-gradient(120deg, #0d47a1, #42a5f5);
            color: #fff;
            border-radius: 14px;
            padding: 30px 32px;
            margin-bottom: 26px;
        }

        .banner h1 {
            font-size: 30px;
            margin-bottom: 6px;
        }

        .banner p {
            opacity: .9;
        }

        .g0 {
            background: linear-gradient(135deg, #42a5f5, #1565c0);
        }

        .g1 {
            background: linear-gradient(135deg, #ab47bc, #6a1b9a);
        }

        .g2 {
            background: linear-gradient(135deg, #26a69a, #00695c);
        }

        .g3 {
            background: linear-gradient(135deg, #ffa726, #e65100);
        }

        .g4 {
            background: linear-gradient(135deg, #ef5350, #b71c1c);
        }

        .stock {
            font-size: 13px;
            font-weight: 600;
            color: #2e7d32;
        }

        .detail {
            display: grid;
            grid-template-columns: minmax(0, 420px) 1fr;
            gap: 34px;
            background: #fff;
            border: 1px solid #e3e8ef;
            border-radius: 16px;
            padding: 28px;
        }

        .gallery {
            height: 400px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 150px;
        }

        .tag {
            display: inline-block;
            background: #e3f2fd;
            color: #0d47a1;
            font-weight: 700;
            font-size: 12px;
            padding: 4px 12px;
            border-radius: 20px;
        }

        .info h1 {
            font-size: 30px;
            margin: 12px 0 8px;
        }

        .big-price {
            font-size: 32px;
            font-weight: 800;
            color: #0d47a1;
            margin-bottom: 6px;
        }

        .desc {
            margin: 16px 0;
            line-height: 1.6;
            color: #4a5668;
        }

        .specs {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .specs th,
        .specs td {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 1px solid #e3e8ef;
            font-size: 14px;
        }

        .specs th {
            width: 34%;
            color: #6b7686;
            font-weight: 600;
            background: #f8fafc;
        }

        .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-primary,
        .btn-ghost {
            padding: 13px 30px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s;
        }

        .btn-primary {
            background: #ffb300;
            color: #2b1d00;
        }

        .btn-primary:hover {
            background: #ffa000;
        }

        .btn-ghost {
            border: 2px solid #0d47a1;
            color: #0d47a1;
        }

        .btn-ghost:hover {
            background: #0d47a1;
            color: #fff;
        }

        .back {
            display: inline-block;
            margin-top: 20px;
            color: #1976d2;
            font-weight: 600;
        }

        .back:hover {
            text-decoration: underline;
        }

        @media (max-width: 760px) {
            .detail {
                grid-template-columns: 1fr;
                padding: 18px;
            }

            .gallery {
                height: 260px;
                font-size: 100px;
            }
        }
    </style>
</head>

<body>
    <div class="wrap">
        <% const gi=brands.indexOf(brand) % 5; %>

            <div class="crumbs">
                <a href="/">Home</a> &rsaquo; <a href="/mobilephone">Mobile Phones</a> &rsaquo;
                <a href="/mobilephone/<%= brand.name %>">
                    <%= brand.name %>
                </a> &rsaquo; <%= phone.name %>
            </div>

            <section class="detail">
                <div class="gallery g<%= gi %>">&#128241;</div>

                <div class="info">
                    <span class="tag">
                        <%= brand.name %>
                    </span>
                    <h1>
                        <%= phone.name %>
                    </h1>
                    <div class="big-price">&#8377;<%= phone.price%>
                    </div>
                    <div class="stock">In stock</div>
                    <p class="desc">
                        <%= phone.description || 'Full description coming soon.' %>
                    </p>

                    <% if (phone.specs) { %>
                        <ul class="specs">
                            <% phone.specs.forEach(i=> { %>
                                <li>
                                    <%= i %>
                                </li>
                                <% }) %>
                        </ul>
                        <% } %>

                            <div class="actions">
                                <span class="btn-primary">Buy now</span>
                                <span class="btn-ghost">Add to cart</span>
                            </div>
                </div>
            </section>

            <a class="back" href="/mobilephone/<%=brand.name%>">&larr; Back to <%= brand.name %></a>
    </div>
</body>

</html>